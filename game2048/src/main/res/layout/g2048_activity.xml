<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/g2048_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FAF8F3">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_subtitle" android:textSize="12sp" android:letterSpacing="0.12" android:textColor="#397D68" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_title" android:textSize="64sp" android:textStyle="bold" android:textColor="#51493F"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:orientation="vertical" android:background="@drawable/g2048_score_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_score_label" android:textSize="12sp" android:textColor="#62584D"/>
<TextView android:id="@+id/g2048_score" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="#51493F" android:accessibilityLiveRegion="polite"/>
</LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:orientation="vertical" android:background="@drawable/g2048_score_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_best_label" android:textSize="12sp" android:textColor="#62584D"/>
<TextView android:id="@+id/g2048_best" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="#51493F" android:accessibilityLiveRegion="polite"/>
</LinearLayout></LinearLayout>
<TextView android:id="@+id/g2048_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#62584D" android:textSize="16sp" android:layout_marginBottom="16dp" android:accessibilityLiveRegion="polite"/>
<com.example.puzzle.game2048.BoardView android:id="@+id/g2048_board" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_controls" android:textSize="12sp" android:gravity="center" android:layout_marginTop="12dp" android:textColor="#62584D"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
<Button android:id="@+id/g2048_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/g2048_arrow_left" android:contentDescription="@string/g2048_left" android:textSize="26sp" android:padding="4dp"/><Button android:id="@+id/g2048_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/g2048_arrow_up" android:contentDescription="@string/g2048_up" android:textSize="26sp" android:padding="4dp"/><Button android:id="@+id/g2048_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/g2048_arrow_down" android:contentDescription="@string/g2048_down" android:textSize="26sp" android:padding="4dp"/><Button android:id="@+id/g2048_right" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/g2048_arrow_right" android:contentDescription="@string/g2048_right" android:textSize="26sp" android:padding="4dp"/></LinearLayout>
<Button android:id="@+id/g2048_restart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_new_game" android:textAllCaps="false" android:backgroundTint="#397D68" android:textColor="#FFFFFF"/>
<Button android:id="@+id/g2048_exit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_exit" android:textAllCaps="false"/>
<Button android:id="@+id/g2048_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/g2048_rules" android:textAllCaps="false"/>
</LinearLayout></ScrollView></FrameLayout>
